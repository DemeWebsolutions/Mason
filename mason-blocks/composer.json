{
  "name": "@demewebsolutions/mason-blocks",
  "private": true,
  "version": "1.0.0",
  "description": "Composer configuration for Mason Blocks plugin",
  "type": "wordpress-plugin",
  "keywords": [
    "wordpress",
    "blocks",
    "gutenberg"
  ],
  "authors": [
    {
      "name": "DemeWebsolutions",
      "email": "info@demewebsolutions.com",
      "homepage": "https://demewebsolutions.com"
    }
  ],
  "require": {
    "php": ">=8.0",
    "composer/installers": "^2.0"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
