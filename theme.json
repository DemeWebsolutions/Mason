{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Stone Mason",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "800px",
			"wideSize": "1280px"
		},
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#ffffff",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#000000",
					"name": "Contrast"
				},
				{
					"slug": "primary",
					"color": "#0071e3",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#86868b",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#f5f5f7",
					"name": "Accent"
				},
				{
					"slug": "success",
					"color": "#34c759",
					"name": "Success"
				},
				{
					"slug": "warning",
					"color": "#ff9500",
					"name": "Warning"
				},
				{
					"slug": "error",
					"color": "#ff3b30",
					"name": "Error"
				}
			],
			"gradients": [
				{
					"slug": "hero-gradient",
					"gradient": "linear-gradient(135deg, #0071e3 0%, #86868b 100%)",
					"name": "Hero Gradient"
				}
			],
			"duotone": [],
			"defaultGradients": false,
			"defaultPalette": false,
			"defaultDuotone": false,
			"custom": true,
			"customGradient": true,
			"customDuotone": true,
			"background": true,
			"text": true,
			"link": true
		},
		"typography": {
			"fluid": true,
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small",
					"fluid": {
						"min": "0.875rem",
						"max": "0.875rem"
					}
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "Medium",
					"fluid": {
						"min": "1rem",
						"max": "1rem"
					}
				},
				{
					"slug": "large",
					"size": "1.25rem",
					"name": "Large",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "x-large",
					"size": "1.75rem",
					"name": "Extra Large",
					"fluid": {
						"min": "1.5rem",
						"max": "1.75rem"
					}
				},
				{
					"slug": "xx-large",
					"size": "2.5rem",
					"name": "2X Large",
					"fluid": {
						"min": "2rem",
						"max": "2.5rem"
					}
				},
				{
					"slug": "xxx-large",
					"size": "3.5rem",
					"name": "3X Large",
					"fluid": {
						"min": "2.5rem",
						"max": "3.5rem"
					}
				}
			],
			"fontFamilies": [
				{
					"slug": "system",
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
					"name": "System Font"
				},
				{
					"slug": "monospace",
					"fontFamily": "ui-monospace, 'SF Mono', Monaco, 'Cascadia Mono', 'Segoe UI Mono', 'Roboto Mono', 'Oxygen Mono', 'Ubuntu Monospace', 'Source Code Pro', 'Fira Mono', 'Droid Sans Mono', 'Courier New', monospace",
					"name": "Monospace"
				}
			],
			"fontWeight": true,
			"lineHeight": true,
			"letterSpacing": true,
			"textDecoration": true,
			"textTransform": true,
			"dropCap": false,
			"writingMode": true
		},
		"spacing": {
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{
					"slug": "10",
					"size": "0.25rem",
					"name": "X-Small"
				},
				{
					"slug": "20",
					"size": "0.5rem",
					"name": "Small"
				},
				{
					"slug": "30",
					"size": "1rem",
					"name": "Medium"
				},
				{
					"slug": "40",
					"size": "1.5rem",
					"name": "Large"
				},
				{
					"slug": "50",
					"size": "2rem",
					"name": "X-Large"
				},
				{
					"slug": "60",
					"size": "3rem",
					"name": "2X-Large"
				},
				{
					"slug": "70",
					"size": "4rem",
					"name": "3X-Large"
				}
			],
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"presets": [
				{
					"slug": "natural",
					"shadow": "0 1px 3px rgba(0, 0, 0, 0.12), 0 1px 2px rgba(0, 0, 0, 0.24)",
					"name": "Natural"
				},
				{
					"slug": "elevated",
					"shadow": "0 4px 6px rgba(0, 0, 0, 0.1), 0 2px 4px rgba(0, 0, 0, 0.06)",
					"name": "Elevated"
				},
				{
					"slug": "deep",
					"shadow": "0 10px 20px rgba(0, 0, 0, 0.15), 0 3px 6px rgba(0, 0, 0, 0.1)",
					"name": "Deep"
				}
			],
			"defaultPresets": false
		},
		"custom": {
			"spacing": {
				"unit": "1rem",
				"containerPadding": "1.5rem"
			},
			"woocommerce": {
				"productGap": "2rem",
				"buttonRadius": "0.375rem"
			},
			"performance": {
				"lazyLoad": true,
				"deferScripts": true
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				},
				"color": {
					"background": true,
					"text": true
				}
			},
			"core/heading": {
				"typography": {
					"fontWeight": true,
					"lineHeight": true
				}
			},
			"core/paragraph": {
				"typography": {
					"lineHeight": true
				}
			},
			"core/image": {
				"spacing": {
					"margin": true,
					"padding": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"right": "var(--wp--custom--spacing--container-padding)",
				"bottom": "0",
				"left": "var(--wp--custom--spacing--container-padding)"
			},
			"blockGap": "var(--wp--preset--spacing--30)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus": {
					"typography": {
						"textDecoration": "underline"
					},
					"outline": {
						"width": "2px",
						"style": "solid",
						"color": "var(--wp--preset--color--primary)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600"
				},
				"border": {
					"radius": "var(--wp--custom--woocommerce--button-radius)"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"right": "1.5rem",
						"bottom": "0.75rem",
						"left": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)"
					}
				},
				":focus": {
					"outline": {
						"width": "2px",
						"style": "solid",
						"color": "var(--wp--preset--color--primary)",
						"offset": "2px"
					}
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxx-large)",
					"lineHeight": "1.2",
					"fontWeight": "700"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "var(--wp--preset--spacing--40)"
					}
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.3",
					"fontWeight": "700"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "var(--wp--preset--spacing--40)"
					}
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.4",
					"fontWeight": "600"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "var(--wp--preset--spacing--30)"
					}
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.5",
					"fontWeight": "600"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"lineHeight": "1.5",
					"fontWeight": "600"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "1.5",
					"fontWeight": "600",
					"textTransform": "uppercase",
					"letterSpacing": "0.05em"
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"border": {
							"width": "2px",
							"style": "solid",
							"color": "var(--wp--preset--color--primary)"
						},
						"color": {
							"background": "transparent",
							"text": "var(--wp--preset--color--primary)"
						}
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "700"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				},
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--40)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "blank",
			"title": "Blank",
			"postTypes": ["page", "post"]
		},
		{
			"name": "product",
			"title": "Product",
			"postTypes": ["product"]
		},
		{
			"name": "shop",
			"title": "Shop",
			"postTypes": ["page"]
		}
	]
}
